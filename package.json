{
  "name": "peerplay",
  "version": "1.0.0",
  "private": true,
  "description": "PeerPlay - peer-to-peer competitive gaming platform (Challenge Accepted.)",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix web install",
    "seed": "npm --prefix server run seed",
    "reset": "npm --prefix server run reset",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "dev": "npm run build && npm run start",
    "tunnel": "bash scripts/tunnel.sh",
    "tunnel:bg": "bash scripts/tunnel.sh --bg",
    "tunnel:watch": "bash scripts/tunnel-supervisor.sh",
    "smoke": "npm --prefix server run smoke"
  }
}
