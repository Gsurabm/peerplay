# PeerPlay server configuration
# Copy this file to server/.env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Secrets - CHANGE THESE IN PRODUCTION
JWT_SECRET=peerplay-dev-secret-change-me
DEVICE_SALT=peerplay-device-salt-v1
WEBHOOK_SECRET=peerplay-webhook-secret-v1

# Business rules (defaults shown; see server/src/config.js)
PLATFORM_FEE_BPS=2500
# MIN_STAKE_CENTS=1000
# STAKE_STEP_CENTS=500
# MIN_DEPOSIT_CENTS=5000
# MIN_WITHDRAW_CENTS=5000
# WITHDRAW_FLOOR_CENTS=5000
# JOURNEY_LENGTH=5
# MOVE_TIMER_SEC=15
# RECOVERY_SEC=30
# MAX_DRAWS=3
# DRAW_PENALTY_BPS=500
# REFERRAL_BONUS_CENTS=1000
# LARGE_WITHDRAWAL_CENTS=20000

# Where the sandbox payment simulator delivers its signed callbacks.
# Use your public tunnel URL when the browser and the server are on different
# hosts, e.g. https://your-tunnel.trycloudflare.com
PAYMENT_BASE_URL=http://127.0.0.1:4000

# ---------------------------------------------------------------------------
# Live payment providers (OPTIONAL - not required to run PeerPlay)
#
# Every deposit in the current build is authorised by the built-in sandbox
# simulator, which posts an HMAC-signed callback to
# POST /api/payments/webhook/:provider - exactly the endpoint a real gateway
# would call. To go live, implement an adapter in
# server/src/services/payments/ for the provider, then fill in the values
# below. No screenshot or client-side confirmation is ever trusted.
# ---------------------------------------------------------------------------

# M-Pesa (Safaricom Daraja / STK Push)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=

# Airtel Money
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=
# AIRTEL_SHORTCODE=

# Card gateway (Visa / Mastercard / Pesalink)
# CARD_GATEWAY_API_KEY=
# CARD_GATEWAY_MERCHANT_ID=

# PayPal
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Pesalink
# PESALINK_API_KEY=
# PESALINK_MERCHANT_ID=

# Direct bank transfer
# BANK_ACCOUNT_NAME=
# BANK_ACCOUNT_NUMBER=
# BANK_BANK_NAME=
